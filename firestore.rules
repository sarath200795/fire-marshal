rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function signedIn() { return request.auth != null; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedMemberOf(orgId) {
      return signedIn()
        && myProfile().orgId == orgId
        && myProfile().status == 'approved';
    }

    function isAdminOf(orgId) {
      return isApprovedMemberOf(orgId) && myProfile().role == 'admin';
    }

    // Enum allow-lists — MUST mirror src/lib/constants.js
    // (TYPES, CAPACITIES, ENTITIES, REGIONS, STATUS, DEFECTS keys).
    function validType(v)     { return v in ['ABC', 'CO2', 'Modular']; }
    function validCapacity(v) { return v in ['2 Kg', '4.5 Kg', '5 Kg', '6 Kg']; }
    function validEntity(v)   { return v in ['1P', '2P', '3P', 'Fitso', 'EBO']; }
    function validRegion(v)   { return v == '' || v in ['North', 'South', 'East', 'West']; }
    function validStatus(v)   { return v in ['active', 'to_be_refilled', 'in_process_refilling', 'closed']; }
    function validDefect(v)   { return v in ['pin', 'stand', 'hose_pipe', 'handle', 'empty', 'over_pressurized']; }

    // Shape/size validation for an extinguisher write payload.
    function validExtinguisher(d) {
      return d.keys().hasAll(['type', 'capacity', 'entity', 'centerName', 'status'])
        && validType(d.type)
        && validCapacity(d.capacity)
        && validEntity(d.entity)
        && (!('region' in d) || validRegion(d.region))
        && validStatus(d.status)
        && d.centerName is string && d.centerName.size() <= 200
        && (!('serialNo' in d) || (d.serialNo is string && d.serialNo.size() <= 60));
    }

    // ── Organizations ──
    match /organizations/{orgId} {
      // Members only — org docs hold name/address/notificationEmail.
      allow read: if isApprovedMemberOf(orgId);
      // Created during register-org flow (the creator records themselves as admin
      // in the same batch); updated/deleted by org admins only.
      allow create: if signedIn();
      allow update, delete: if isAdminOf(orgId);

      // ── Extinguishers ── (org-scoped, validated)
      // Soft-delete is an UPDATE (sets deletedAt) any member can do; a permanent
      // PURGE is a real delete, restricted to admins.
      match /extinguishers/{extId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId)
          && validExtinguisher(request.resource.data);
        allow delete: if isAdminOf(orgId);
      }

      // ── Reports / approval queue ──
      match /reports/{reportId} {
        allow read: if isApprovedMemberOf(orgId);

        // Public QR visitors (unauthenticated) may submit ONE pending report,
        // tightly validated and bound to a real extinguisher in this org.
        allow create: if request.resource.data.approvalStatus == 'pending'
          && request.resource.data.source in ['qr', 'portal']
          && request.resource.data.kind in ['defect', 'status_change']
          && request.resource.data.extId is string
          && exists(/databases/$(database)/documents/organizations/$(orgId)/extinguishers/$(request.resource.data.extId))
          && (request.resource.data.kind != 'defect' || validDefect(request.resource.data.defectType))
          && (request.resource.data.kind != 'status_change' || validStatus(request.resource.data.newStatus))
          && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
          && (!('extLabel' in request.resource.data) || request.resource.data.extLabel.size() <= 200);

        // Approve / reject is an org member action.
        allow update, delete: if isApprovedMemberOf(orgId);
      }

      // ── Audit log ── append-only, immutable. Members read + append; no edits
      // or deletes (even by admins) so the trail can't be tampered with.
      match /auditLogs/{logId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if isApprovedMemberOf(orgId);
        allow update, delete: if false;
      }

      // ── Meta (stats counters) ── maintained by members' client batches.
      match /meta/{doc} {
        allow read: if isApprovedMemberOf(orgId);
        allow write: if isApprovedMemberOf(orgId);
      }

      // ── Safety signage inventory ── site-wise signage records.
      match /signages/{sigId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId)
          && request.resource.data.centerName is string
          && request.resource.data.centerName.size() <= 200;
        allow delete: if isApprovedMemberOf(orgId);
      }

      // ── Signage photos ── one base64 image per signage, fetched on demand so
      // the signage list stays lightweight. Same org-member access as signages.
      match /signagePhotos/{sigId} {
        allow read, write: if isApprovedMemberOf(orgId);
      }

      // ── Mock drills / emergency response records ── site-wise drill reports.
      match /mockDrills/{drillId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId)
          && request.resource.data.scenario is string;
        allow delete: if isApprovedMemberOf(orgId);
      }
    }

    // ── Users ──
    match /users/{uid} {
      // A user reads their own profile; admins read members of their own org.
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdminOf(resource.data.orgId)
      );
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        isAdminOf(resource.data.orgId)
      );
    }

    // ── Public org name index ── minimal { orgId, name } so signup can resolve
    // an org by name without reading the member-only organizations docs.
    match /orgIndex/{nameLower} {
      allow read: if true;
      // Created in the register-org batch; never updated/deleted from clients.
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ── Public QR mirror ── world-readable; writes locked to the owning org.
    match /qr/{token} {
      allow read: if true;
      allow create: if isApprovedMemberOf(request.resource.data.orgId);
      allow update, delete: if isApprovedMemberOf(resource.data.orgId);
    }
  }
}
