rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApprovedMemberOf(orgId) {
      return signedIn()
        && myProfile().orgId == orgId
        && myProfile().status == 'approved';
    }

    function isAdminOf(orgId) {
      return isApprovedMemberOf(orgId) && myProfile().role == 'admin';
    }

    // Read-only demo account (matched by email; set '' to disable).
    function demoEmail() { return 'demo@email.com'; }
    function isDemoUser() {
      return signedIn()
        && demoEmail() != ''
        && request.auth.token.email != null
        && request.auth.token.email.lower() == demoEmail();
    }
    function notDemo() { return !isDemoUser(); }

    function validType(v)     { return v in ['ABC', 'CO2', 'Modular']; }
    function validCapacity(v) { return v in ['2 Kg', '4.5 Kg', '5 Kg', '6 Kg']; }
    function validEntity(v)   { return v in ['1P', '2P', '3P', 'Fitso', 'EBO']; }
    function validRegion(v)   { return v == '' || v in ['North', 'South', 'East', 'West']; }
    function validStatus(v)   { return v in ['active', 'to_be_refilled', 'in_process_refilling', 'closed']; }
    function validDefect(v)   { return v in ['pin', 'stand', 'hose_pipe', 'handle', 'empty', 'over_pressurized']; }

    function validExtinguisher(d) {
      return d.keys().hasAll(['type', 'capacity', 'entity', 'centerName', 'status'])
        && validType(d.type)
        && validCapacity(d.capacity)
        && validEntity(d.entity)
        && (!('region' in d) || validRegion(d.region))
        && validStatus(d.status)
        && d.centerName is string && d.centerName.size() <= 200
        && (!('serialNo' in d) || (d.serialNo is string && d.serialNo.size() <= 60));
    }

    match /organizations/{orgId} {
      allow read: if isApprovedMemberOf(orgId);
      allow create: if signedIn() && notDemo();
      allow update, delete: if isAdminOf(orgId) && notDemo();

      match /extinguishers/{extId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId) && notDemo()
          && validExtinguisher(request.resource.data);
        allow delete: if isAdminOf(orgId) && notDemo();
      }

      match /reports/{reportId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if notDemo()
          && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.source in ['qr', 'portal']
          && (
            (
              request.resource.data.kind in ['defect', 'status_change']
              && request.resource.data.extId is string
              && exists(/databases/$(database)/documents/organizations/$(orgId)/extinguishers/$(request.resource.data.extId))
              && (request.resource.data.kind != 'defect' || validDefect(request.resource.data.defectType))
              && (request.resource.data.kind != 'status_change' || validStatus(request.resource.data.newStatus))
              && (!('note' in request.resource.data) || request.resource.data.note.size() <= 500)
              && (!('extLabel' in request.resource.data) || request.resource.data.extLabel.size() <= 200)
            )
            ||
            (
              request.resource.data.kind == 'asset_defect'
              && request.resource.data.assetKind in ['aed', 'fas']
              && request.resource.data.assetRefId is string
              && request.resource.data.defect is string
              && request.resource.data.defect.size() <= 100
              && (
                (request.resource.data.assetKind == 'aed' && exists(/databases/$(database)/documents/organizations/$(orgId)/aeds/$(request.resource.data.assetRefId)))
                || (request.resource.data.assetKind == 'fas' && exists(/databases/$(database)/documents/organizations/$(orgId)/fas/$(request.resource.data.assetRefId)))
              )
            )
          );
        allow update, delete: if isApprovedMemberOf(orgId) && notDemo();
      }

      match /auditLogs/{logId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if isApprovedMemberOf(orgId) && notDemo();
        allow update, delete: if false;
      }

      match /meta/{doc} {
        allow read: if isApprovedMemberOf(orgId);
        allow write: if isApprovedMemberOf(orgId) && notDemo();
      }

      match /signages/{sigId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId) && notDemo()
          && request.resource.data.centerName is string
          && request.resource.data.centerName.size() <= 200;
        allow delete: if isApprovedMemberOf(orgId) && notDemo();
      }

      match /aeds/{aedId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId) && notDemo()
          && request.resource.data.centerName is string
          && request.resource.data.centerName.size() <= 200;
        allow delete: if isApprovedMemberOf(orgId) && notDemo();
      }

      match /fas/{fasId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId) && notDemo()
          && request.resource.data.centerName is string
          && request.resource.data.centerName.size() <= 200;
        allow delete: if isApprovedMemberOf(orgId) && notDemo();
      }

      match /mockDrills/{drillId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create, update: if isApprovedMemberOf(orgId) && notDemo()
          && request.resource.data.scenario is string;
        allow delete: if isApprovedMemberOf(orgId) && notDemo();

        match /photos/{photoId} {
          allow read: if isApprovedMemberOf(orgId);
          allow write: if isApprovedMemberOf(orgId) && notDemo();
        }
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdminOf(resource.data.orgId)
      );
      allow create: if signedIn() && request.auth.uid == uid && notDemo();
      allow update: if signedIn() && notDemo() && (
        request.auth.uid == uid ||
        isAdminOf(resource.data.orgId)
      );
    }

    match /orgIndex/{nameLower} {
      allow read: if true;
      allow create: if signedIn() && notDemo();
      allow update, delete: if false;
    }

    // Public QR mirror — world-readable. A QR may only be CREATED by an org
    // admin; members can keep an existing mirror in sync (status/detail edits).
    match /qr/{token} {
      allow read: if true;
      allow create: if isAdminOf(request.resource.data.orgId) && notDemo();
      allow update, delete: if isApprovedMemberOf(resource.data.orgId) && notDemo();
    }
  }
}
