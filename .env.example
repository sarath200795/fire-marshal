# Copy this file to ".env" and fill in your Firebase project's web config.
# Find these values in: Firebase Console > Project settings > General > Your apps > Web app > SDK setup.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# Optional — enables the "Explore the live demo" button on the login page.
# Create an APPROVED demo member in Firebase Auth (ideally an admin of a sample
# organization with example data), then put its credentials here. Leave unset
# to hide the demo button.
VITE_DEMO_EMAIL=demo@your-domain.com
VITE_DEMO_PASSWORD=your-demo-password
